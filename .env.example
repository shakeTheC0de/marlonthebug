# MarlonTheBug — Docker Compose stack
# Copia este archivo a .env y genera un token real:
#   cp .env.example .env
#   openssl rand -hex 32
# scripts/install.sh hace ambos pasos automáticamente.

# Directorio de datos en el host. Contiene SQLite, informes, feeds, logs y token.
MTB_DATA_DIR=./mtb-data

# Puerto del panel, accesible solo en 127.0.0.1.
MTB_PANEL_PORT=8765

# Imágenes publicadas en GHCR. `docker compose up -d --build` construye localmente.
MTB_PANEL_IMAGE=ghcr.io/shakethec0de/marlonthebug:latest
MTB_TOOLS_IMAGE=ghcr.io/shakethec0de/marlonthebug-tools:latest

# Token compartido entre panel y tools-runner. Obligatorio y secreto.
MTB_TOOLS_TOKEN=

# Token compartido entre panel y exploit-runner. Obligatorio y secreto.
MTB_EXPLOIT_TOKEN=

# Explotación aislada: runner (contenedor efímero vía exploit-runner), docker
# (Docker local desde el panel nativo) o local (solo desarrollo).
MTB_EXPLOIT_BACKEND=runner
MTB_EXPLOIT_URL=http://exploit-runner:8090
MTB_EXPLOIT_IMAGE=ghcr.io/shakethec0de/marlonthebug-exploit:latest
MTB_EXPLOIT_TIMEOUT=150
MTB_EXPLOIT_MEMORY=512m
MTB_EXPLOIT_CPUS=1.0
MTB_EXPLOIT_PIDS_LIMIT=128
# Red que usan los contenedores de explotación. bridge = salida a Internet y
# host.docker.internal. Usa marlonthebug_mtb solo para laboratorios internos.
MTB_EXPLOIT_NETWORK=bridge

# Backend de herramientas: remote (tools-runner), docker (socket local) o local.
MTB_TOOLS_BACKEND=remote
MTB_TOOLS_URL=http://tools-runner:8080
MTB_TOOLS_TIMEOUT=180
MTB_TOOLS_CONCURRENCY=2
MTB_TOOLS_MAX_OUTPUT=60000

# UID/GID del usuario del host que ejecuta los contenedores.
# En Linux evita problemas de permisos con ./mtb-data.
# macOS: deja los valores por defecto o usa `id -u` / `id -g`.
MTB_UID=10001
MTB_GID=10001

# Inteligencia de vulnerabilidades.
MTB_INTEL_OFFLINE=0
MTB_MAX_CPE_LOOKUPS=5
MTB_CPE_TIMEOUT=12
# Clave pública Ed25519 para bundles firmados (ruta dentro del contenedor).
# MTB_BUNDLE_PUBLIC_KEY=/data/config/intel-signing.pub
# MTB_REQUIRE_BUNDLE_SIGNATURE=1
# NVD_API_KEY=

# Depuración: MTB_LOG_LEVEL=debug
