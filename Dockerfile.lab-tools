# Native arm64/amd64 lab toolbox built on the MarlonTheBug tools image.
# It adds Metasploit Framework on top of nmap/sqlmap/ffuf/nikto/nuclei/commix.
FROM ghcr.io/shakethec0de/marlonthebug-tools:latest

USER root
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        metasploit-framework \
        postgresql \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
CMD ["bash"]
